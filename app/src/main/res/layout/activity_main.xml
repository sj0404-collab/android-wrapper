<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a1a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#12122a"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VPN Wrapper"
            android:textSize="18sp"
            android:textColor="#00d4ff"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tv_vpn_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textSize="12sp"
            android:textColor="#F44336"
            android:padding="6dp"
            android:background="#1a1a30"/>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#0f0f25"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="#00d4ff"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="#00d4ff"
        app:tabTextColor="#606080"
        app:tabIconTint="#606080"
        app:tabPaddingStart="4dp"
        app:tabPaddingEnd="4dp"
        app:tabMinWidth="60dp"/>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
