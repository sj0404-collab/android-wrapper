<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a1a">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0f1628"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Серверы"
            android:textSize="16sp"
            android:textColor="#00d4ff"
            android:textStyle="bold"/>

        <!-- Result display -->
        <TextView
            android:id="@+id/tv_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#4CAF50"
            android:layout_marginTop="4dp"
            android:minHeight="20dp"/>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_check"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="🔍 Проверить все"
                android:textSize="12sp"
                android:backgroundTint="#1a2a3a" android:textColor="#00d4ff"/>

            <Button
                android:id="@+id/btn_speed"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="⚡ Тест скорости"
                android:textSize="12sp"
                android:backgroundTint="#1a2a3a" android:textColor="#00d4ff"
                android:layout_marginStart="4dp"/>

            <Button
                android:id="@+id/btn_ip"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="🌐 Мой IP"
                android:textSize="12sp"
                android:backgroundTint="#1a2a3a" android:textColor="#00d4ff"
                android:layout_marginStart="4dp"/>

            <Button
                android:id="@+id/btn_add_server"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="+"
                android:textSize="24sp"
                android:backgroundTint="#1a3a1a" android:textColor="#4CAF50"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Server list -->
    <ListView
        android:id="@+id/lv_servers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1a2a1a"
        android:dividerHeight="1dp"/>

</LinearLayout>
