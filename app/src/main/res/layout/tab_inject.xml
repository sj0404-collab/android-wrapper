<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a1a">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1a0f1a"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💉 Внедрение и VPN"
            android:textSize="20sp"
            android:textColor="#e040fb"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выберите приложения (📱 — пользовательские, ⚙ — системные)"
            android:textSize="11sp"
            android:textColor="#806080"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Filter + Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/et_app_filter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="Поиск приложений..."
            android:textSize="12sp"
            android:textColor="#ffffff"
            android:textColorHint="#404060"
            android:background="#1a1a30"
            android:paddingStart="12dp"
            android:inputType="text"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btn_select_user"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="📱"
            android:textSize="16sp"
            android:backgroundTint="#1a3a1a"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btn_select_all"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="☑"
            android:textSize="16sp"
            android:backgroundTint="#2a2a40"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/btn_clear_selection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textSize="14sp"
            android:backgroundTint="#401a1a"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Count -->
    <TextView
        android:id="@+id/tv_selected_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выбрано: 0"
        android:textSize="12sp"
        android:textColor="#e040fb"
        android:padding="8dp"
        android:paddingStart="16dp"/>

    <!-- Grid of apps -->
    <GridView
        android:id="@+id/gv_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="4"
        android:verticalSpacing="4dp"
        android:horizontalSpacing="4dp"
        android:padding="8dp"
        android:stretchMode="columnWidth"
        android:gravity="center"/>

</LinearLayout>
